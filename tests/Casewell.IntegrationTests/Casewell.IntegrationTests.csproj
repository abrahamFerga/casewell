<Project Sdk="Microsoft.NET.Sdk">

  <!-- E2E against the real host: Testcontainers Postgres, real platform + legal migrations, real
       seeding, real RBAC, real approval store — the Mock AI provider is the only stand-in. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Casewell.Host\Casewell.Host.csproj" />
  </ItemGroup>

  <!-- Golden-conversation evals are data, not code: they must reach the test output. -->
  <ItemGroup>
    <Content Include="Evals\cases\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
