{
  "name": "casewell",
  "industry": "legal",
  "loop": "deliver",
  "platform": {
    "version": "0.1.0-alpha.14",
    "feed": "vendored"
  },
  "cloud": "azure",
  "connectors": [
    "slack",
    "docusign",
    "quickbooks",
    "outlook",
    "dropbox"
  ],
  "capabilities": [
    {
      "name": "vector-db",
      "provider": "pgvector"
    },
    {
      "name": "file-storage",
      "provider": "azure-blob"
    },
    {
      "name": "ocr",
      "provider": "azure-document-intelligence"
    }
  ],
  "github": {
    "repo": "abrahamFerga/casewell",
    "project": 7,
    "visibility": "public"
  },
  "autonomy": {
    "level": 0,
    "maxOpenPRs": 3,
    "maxMergesPerTick": 2,
    "readyFloor": 3,
    "maxIssuesPerSweep": 8,
    "maxNewCapabilities": 5
  },
  "skills": {
    "self": {
      "marketplace": "plenipo-agents",
      "repo": "abrahamFerga/plenipo-agents",
      "plugins": [
        "plenipo",
        "harness",
        "scout",
        "define",
        "shape",
        "deliver",
        "steward"
      ]
    },
    "external": [
      {
        "marketplace": "dotnet/skills",
        "plugins": [
          "dotnet",
          "dotnet-aspnet",
          "dotnet-data",
          "dotnet-ai"
        ],
        "reason": "Authoritative .NET coding-agent skills maintained by the .NET team \u2014 Aspire wiring, ASP.NET Core minimal-API conventions, EF Core migrations, MAF / Azure OpenAI patterns."
      },
      {
        "marketplace": "anthropics/skills",
        "plugins": [
          "pdf",
          "docx"
        ],
        "reason": "Document generation for engagement letters, invoices, court filings, and PDF exports for GDPR data-subject requests."
      }
    ]
  }
}
